# TwinOS Backend Environment Configuration

# 服务器配置
PORT=1234
ENVIRONMENT=development
LOG_LEVEL=info

# 数据库配置
DATABASE_PATH=./data/twin-os.db

# 微信数据库配置
WECHAT_DB_PATH=

# DeepSeek AI配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 加密配置
ENCRYPTION_KEY=twin-os-default-key-change-in-production

# 安全配置
MAX_READ_FREQUENCY=5